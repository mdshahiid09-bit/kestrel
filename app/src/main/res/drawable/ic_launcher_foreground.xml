<?xml version="1.0" encoding="utf-8"?>
<!-- Kestrel Cyber Falcon Icon: Modern geometric Falcon with developer bracket accents -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Core Radial Glow -->
    <path android:pathData="M14,54a40,40 0,1 0,80 0a40,40 0,1 0,-80 0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="42"
                android:startColor="#5000F5D4"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Outer Tech Halo / Hex Ring -->
    <path
        android:pathData="M54,20 L84,37 L84,71 L54,88 L24,71 L24,37 Z"
        android:strokeColor="#2500F5D4"
        android:strokeWidth="1.2"
        android:fillColor="#00000000" />

    <!-- Left Wing - Top Blade -->
    <path android:pathData="M54,34 L40,28 L22,33 L38,41 L54,41 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="22" android:startY="28" android:endX="54" android:endY="41"
                android:startColor="#FF00F5D4" android:endColor="#FF00BBF9" />
        </aapt:attr>
    </path>

    <!-- Right Wing - Top Blade -->
    <path android:pathData="M54,34 L68,28 L86,33 L70,41 L54,41 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="86" android:startY="28" android:endX="54" android:endY="41"
                android:startColor="#FF7B2CBF" android:endColor="#FF00BBF9" />
        </aapt:attr>
    </path>

    <!-- Left Wing - Mid Blade -->
    <path android:pathData="M54,42 L36,42 L25,47 L39,53 L54,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="25" android:startY="42" android:endX="54" android:endY="53"
                android:startColor="#FF00BBF9" android:endColor="#FF4361EE" />
        </aapt:attr>
    </path>

    <!-- Right Wing - Mid Blade -->
    <path android:pathData="M54,42 L72,42 L83,47 L69,53 L54,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="83" android:startY="42" android:endX="54" android:endY="53"
                android:startColor="#FF9D4EDD" android:endColor="#FF4361EE" />
        </aapt:attr>
    </path>

    <!-- Left Wing - Lower Feather -->
    <path android:pathData="M54,51 L38,53 L31,59 L44,63 L54,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="31" android:startY="51" android:endX="54" android:endY="63"
                android:startColor="#FF3A0CA3" android:endColor="#FF4361EE" />
        </aapt:attr>
    </path>

    <!-- Right Wing - Lower Feather -->
    <path android:pathData="M54,51 L70,53 L77,59 L64,63 L54,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="77" android:startY="51" android:endX="54" android:endY="63"
                android:startColor="#FF7209B7" android:endColor="#FF4361EE" />
        </aapt:attr>
    </path>

    <!-- Central Body / Chevron Shield -->
    <path android:pathData="M54,44 L44,57 L54,77 L64,57 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="44" android:endX="54" android:endY="77"
                android:startColor="#FF1E293B" android:endColor="#FF0F172A" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,44 L44,57 L54,77 L64,57 Z"
        android:strokeColor="#FF00F5D4"
        android:strokeWidth="1.2"
        android:fillColor="#00000000" />

    <!-- Core Energy Crystal / Prism Heart -->
    <path android:pathData="M54,51 L48,59 L54,70 L60,59 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="51" android:endX="54" android:endY="70"
                android:startColor="#FFFFFFFF" android:endColor="#FF00F5D4" />
        </aapt:attr>
    </path>

    <!-- Falcon Head & Crest -->
    <path android:pathData="M54,23 L59,32 L54,43 L49,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="23" android:endX="54" android:endY="43"
                android:startColor="#FFFFFFFF" android:endColor="#FFD1D5DB" />
        </aapt:attr>
    </path>

    <!-- Beak Tip (Sharp, Golden Energy) -->
    <path android:fillColor="#FFFFBE0B" android:pathData="M54,37 L56,43 L54,46 L52,43 Z" />

    <!-- Falcon Eyes (Cyan Neon) -->
    <path android:fillColor="#FF00F5D4" android:pathData="M51,32 L53,34 L51,35 L49,34 Z" />
    <path android:fillColor="#FF00F5D4" android:pathData="M57,32 L59,34 L57,35 L55,34 Z" />

    <!-- Tail Plumage (Sharp Jet Wings) -->
    <path android:pathData="M51,73 L54,84 L57,73 Z" android:fillColor="#FF00F5D4" />
    <path android:pathData="M46,67 L44,79 L50,73 Z" android:fillColor="#FF4361EE" />
    <path android:pathData="M62,67 L64,79 L58,73 Z" android:fillColor="#FF7209B7" />

    <!-- Code Brackets Accents ( < and > on flanks) -->
    <path
        android:pathData="M18,50 L14,54 L18,58"
        android:strokeColor="#FF00F5D4"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M90,50 L94,54 L90,58"
        android:strokeColor="#FF7B2CBF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
